# Flowbot settings. Copy to .env, fill in the values marked REQUIRED, then:
#   docker compose up -d
# Run the same command after every change to this file.
#
# If a value contains a $ sign, wrap the value in single quotes.
# Every setting is described in docs/configuration.md.

# ── Server ────────────────────────────────────────────────────────────────
FLOWBOT_VERSION=v1.1.0
FLOWBOT_PORT=8000

# The address people use to reach Flowbot, with no trailing slash. Behind
# HTTPS this is your https:// domain. Set both to the same value.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000

# Websites allowed to call the chat API from a browser, as a JSON list,
# for example ["https://www.example.com"]. ["*"] allows any site.
CORS_ORIGINS=["*"]

# ── Owner account (REQUIRED) ──────────────────────────────────────────────
# Created on first start. To change the password later, change it here and
# run docker compose up -d. Changing the email creates a second owner
# account; it does not rename the first.
OWNER_EMAIL=
# At least 8 characters.
OWNER_PASSWORD=
OWNER_FULL_NAME=

# ── Email (optional) ──────────────────────────────────────────────────────
# The Gmail account that sends invitations and handoff notices, and an app
# password for it: Google account → Security → 2-Step Verification → App
# passwords. Your normal Gmail password won't work. Leave both empty and
# no email is sent, so set this up before you invite teammates.
GMAIL_USER=
APP_PASSWORD=

# ── Sign-in tokens (REQUIRED) ─────────────────────────────────────────────
# A long random string. Generate one with:  openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Local model: routes typed messages to your flows ──────────────────────
# in_process: runs the GGUF file in models/ inside Flowbot (see models/README.md)
# http:       uses an OpenAI-compatible server such as Ollama
LLM_MODE=in_process
LLM_MODEL_PATH=llm_models/model.gguf
LLM_CONTEXT_TOKENS=4096
# LLM_MODE=http only:
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:0.6b
LLM_TIMEOUT_SECONDS=30

# ── Knowledge base: answers from your documents (optional) ────────────────
# Uses OpenAI and costs money per answered message. Off until you enable it.
# OpenAI is the only supported provider for now; others are planned.
RAG_ENABLED=false
OPENAI_API_KEY=
RAG_SCORE_THRESHOLD=0.75

# ── Limits ────────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# ── Leave these as they are ───────────────────────────────────────────────
APP_NAME=Flowbot
DEBUG=false
ENVIRONMENT=production
DATABASE_PATH=data/flowbot.db
FILE_STORAGE_DIR=data/uploads
